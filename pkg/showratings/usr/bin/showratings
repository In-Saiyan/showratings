#!/bin/bash

# showratings - Rating fetcher for competitive programming platforms
# Version: 1.1.0

# Config and ratings file paths
CONFIG_DIR="$HOME/.config/rating"
CONFIG_FILE="$CONFIG_DIR/rating.conf"
RATINGS_FILE="$CONFIG_DIR/ratings.log"
TIME_THRESHOLD=$((60 * 60 * 24 * 2))  # 2 days in seconds

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# Function to display help message
show_help() {
    echo "showratings v1.1.0 - Rating fetcher for competitive programming platforms"
    echo "Usage: showratings.sh [OPTIONS]"
    echo "Fetch your ratings for Codeforces, CodeChef, LeetCode, and GitHub stats."
    echo ""
    echo "Options:"
    echo "  -u, --update         Force update the ratings regardless of the 2-day limit"
    echo "  -r, --remove [mode]  Remove 'accounts' or 'logs' (e.g., --remove accounts)"
    echo "  -s, --setup          Enter setup mode to re-enter usernames for all platforms"
    echo "  -n, --numbers-only   Only output the rating numbers for each platform"
    echo "  -ol, --one-line      Display stats in compact one-line format"
    echo "  -f, --full           Show full GitHub stats (including following and starred)"
    echo "  -cf, --codeforces    Show only Codeforces rating"
    echo "  -cc, --codechef      Show only CodeChef rating"
    echo "  -lc, --leetcode      Show only LeetCode rating"
    echo "  -gh, --github        Show only GitHub stats"
    echo "  -v, --version        Show version information"
    echo "  -h, --help           Display this help message"
    exit 0
}

# Function to display version information
show_version() {
    echo "showratings v1.1.0"
    echo "Rating fetcher for Codeforces, CodeChef, LeetCode, and GitHub"
    echo "Copyright (c) 2025 - Licensed under MIT"
    exit 0
}

# Function to reset and ask for usernames in setup mode
setup_config() {
    echo "Setting up configuration. Please provide your usernames for the following platforms."
    echo -n > "$CONFIG_FILE"  # Clear the config file

    current_time=$(date +%s)

    read -p "Enter your Codeforces username (or leave blank to skip): " codeforces_username
    if [[ -n "$codeforces_username" ]]; then
        echo "Codeforces=$codeforces_username|$current_time" >> "$CONFIG_FILE"
    fi

    read -p "Enter your CodeChef username (or leave blank to skip): " codechef_username
    if [[ -n "$codechef_username" ]]; then
        echo "CodeChef=$codechef_username|$current_time" >> "$CONFIG_FILE"
    fi

    read -p "Enter your LeetCode username (or leave blank to skip): " leetcode_username
    if [[ -n "$leetcode_username" ]]; then
        echo "LeetCode=$leetcode_username|$current_time" >> "$CONFIG_FILE"
    fi

    read -p "Enter your GitHub username (or leave blank to skip): " github_username
    if [[ -n "$github_username" ]]; then
        echo "GitHub=$github_username|$current_time" >> "$CONFIG_FILE"
    fi

    echo "Configuration saved!"
}

# Function to check if config file exists and has at least one username
check_config() {
    if [[ ! -f "$CONFIG_FILE" || $(grep -c '=' "$CONFIG_FILE") -eq 0 ]]; then
        echo "No usernames found in config file. Entering setup mode."
        setup_config
    fi
}

# Function to read a username and setup timestamp from the config file
get_username_and_timestamp() {
    local site="$1"
    local entry=$(grep "^$site=" "$CONFIG_FILE" | cut -d '=' -f 2)
    local username=$(echo "$entry" | cut -d '|' -f 1)
    local timestamp=$(echo "$entry" | cut -d '|' -f 2)
    echo "$username|$timestamp"
}

# Function to save the rating and timestamp
save_rating() {
    local site="$1"
    local rating="$2"
    echo "$site $rating $(date +%s)" >> "$RATINGS_FILE"
}

# Function to fetch old rating if it's within 2 days and username was not updated
get_cached_rating() {
    local site="$1"
    local username_timestamp="$2"
    local setup_timestamp=$(echo "$username_timestamp" | cut -d '|' -f 2)

    if [[ -f "$RATINGS_FILE" ]]; then
        last_entry=$(grep "^$site" "$RATINGS_FILE" | tail -n 1)
        if [[ -n "$last_entry" ]]; then
            timestamp=$(echo "$last_entry" | awk '{print $3}')
            rating=$(echo "$last_entry" | awk '{print $2}')
            current_time=$(date +%s)
            elapsed_time=$((current_time - timestamp))
            if ((elapsed_time < TIME_THRESHOLD)) && ((setup_timestamp <= timestamp)); then
                echo "$rating"
                return 0
            fi
        fi
    fi
    return 1  # No valid cached rating
}

# Fetch Codeforces rating
get_codeforces_rating() {
    local username_timestamp="$1"
    local username=$(echo "$username_timestamp" | cut -d '|' -f 1)
    local cached_rating

    cached_rating=$(get_cached_rating "Codeforces" "$username_timestamp")
    if [[ -n "$cached_rating" && "$FORCE_UPDATE" == false ]]; then
        if [[ "$NUMBERS_ONLY" == true ]]; then
            echo "$cached_rating"
        elif [[ "$ONE_LINE" == true ]]; then
            echo "$cached_rating"
        else
            echo "Codeforces Rating (cached): $cached_rating"
        fi
        return
    fi

    [[ -z "$username" ]] && return  # Skip if no username
    response=$(curl -s "https://codeforces.com/api/user.info?handles=$username")
    status=$(echo "$response" | jq -r '.status')
    if [[ "$status" == "OK" ]]; then
        rating=$(echo "$response" | jq -r '.result[0].rating')
        max_rating=$(echo "$response" | jq -r '.result[0].maxRating')
        if [[ "$NUMBERS_ONLY" == true ]]; then
            echo "$rating"
        elif [[ "$ONE_LINE" == true ]]; then
            echo "$rating (Max: $max_rating)"
        else
            echo "Codeforces Rating: $rating (Max: $max_rating)"
        fi
        save_rating "Codeforces" "$rating"
    fi
}

# Fetch CodeChef rating
get_codechef_rating() {
    local username_timestamp="$1"
    local username=$(echo "$username_timestamp" | cut -d '|' -f 1)
    local cached_rating

    cached_rating=$(get_cached_rating "CodeChef" "$username_timestamp")
    if [[ -n "$cached_rating" && "$FORCE_UPDATE" == false ]]; then
        if [[ "$NUMBERS_ONLY" == true ]]; then
            echo "$cached_rating"
        elif [[ "$ONE_LINE" == true ]]; then
            echo "$cached_rating"
        else
            echo "CodeChef Rating (cached): $cached_rating"
        fi
        return
    fi

    [[ -z "$username" ]] && return  # Skip if no username
    response=$(curl -s "https://www.codechef.com/users/$username")
    rating=$(echo "$response" | grep -oP '(?<=<div class="rating-number">)\d+')
    if [[ -n "$rating" ]]; then
        if [[ "$NUMBERS_ONLY" == true ]]; then
            echo "$rating"
        elif [[ "$ONE_LINE" == true ]]; then
            echo "$rating"
        else
            echo "CodeChef Rating: $rating"
        fi
        save_rating "CodeChef" "$rating"
    fi
}

# Fetch LeetCode rating
get_leetcode_rating() {
    local username_timestamp="$1"
    local username=$(echo "$username_timestamp" | cut -d '|' -f 1)
    local cached_rating

    cached_rating=$(get_cached_rating "LeetCode" "$username_timestamp")
    if [[ -n "$cached_rating" && "$FORCE_UPDATE" == false ]]; then
        if [[ "$NUMBERS_ONLY" == true ]]; then
            echo "$cached_rating"
        elif [[ "$ONE_LINE" == true ]]; then
            echo "$cached_rating"
        else
            echo "LeetCode Rating (cached): $cached_rating"
        fi
        return
    fi

    [[ -z "$username" ]] && return  # Skip if no username
    response=$(curl -s "https://leetcode.com/$username/")
    rating=$(echo "$response" | grep -oP '(?<=<span class="text-[24px] font-medium text-label-1 dark:text-dark-label-1">)\d+')
    if [[ -n "$rating" ]]; then
        if [[ "$NUMBERS_ONLY" == true ]]; then
            echo "$rating"
        elif [[ "$ONE_LINE" == true ]]; then
            echo "$rating"
        else
            echo "LeetCode Rating: $rating"
        fi
        save_rating "LeetCode" "$rating"
    fi
}

# Fetch GitHub stats
get_github_stats() {
    local username_timestamp="$1"
    local username=$(echo "$username_timestamp" | cut -d '|' -f 1)
    local cached_rating

    cached_rating=$(get_cached_rating "GitHub" "$username_timestamp")
    if [[ -n "$cached_rating" && "$FORCE_UPDATE" == false ]]; then
        if [[ "$NUMBERS_ONLY" == true ]]; then
            echo "$cached_rating"
        elif [[ "$ONE_LINE" == true ]]; then
            # Parse cached stats for oneline display
            repos=$(echo "$cached_rating" | grep -oP 'repos:\K\d+')
            followers=$(echo "$cached_rating" | grep -oP 'followers:\K\d+')
            following=$(echo "$cached_rating" | grep -oP 'following:\K\d+')
            stars=$(echo "$cached_rating" | grep -oP 'stars:\K\d+')
            if [[ "$FULL" == true ]]; then
                echo "$repos repos, $followers followers, $following following, $stars starred"
            else
                echo "$repos repos, $followers followers"
            fi
        else
            # Parse cached stats for better display
            repos=$(echo "$cached_rating" | grep -oP 'repos:\K\d+')
            followers=$(echo "$cached_rating" | grep -oP 'followers:\K\d+')
            following=$(echo "$cached_rating" | grep -oP 'following:\K\d+')
            stars=$(echo "$cached_rating" | grep -oP 'stars:\K\d+')
            echo "GitHub Stats (cached):"
            echo "  Repositories: $repos"
            echo "  Followers: $followers"
            if [[ "$FULL" == true ]]; then
                echo "  Following: $following"
                echo "  Starred: $stars"
            fi
        fi
        return
    fi

    [[ -z "$username" ]] && return  # Skip if no username
    
    # Fetch user info from GitHub API
    response=$(curl -s "https://api.github.com/users/$username")
    
    # Check if user exists
    if echo "$response" | grep -q '"message": "Not Found"'; then
        echo "GitHub user '$username' not found"
        return
    fi
    
    # Extract basic stats from user info
    public_repos=$(echo "$response" | jq -r '.public_repos // 0' 2>/dev/null || echo "0")
    followers=$(echo "$response" | jq -r '.followers // 0' 2>/dev/null || echo "0")
    following=$(echo "$response" | jq -r '.following // 0' 2>/dev/null || echo "0")
    
    # Fallback if jq is not available
    if [[ "$public_repos" == "0" && "$followers" == "0" && "$following" == "0" ]]; then
        public_repos=$(echo "$response" | grep -oP '(?<="public_repos":)\s*\d+' | tr -d ' ' || echo "0")
        followers=$(echo "$response" | grep -oP '(?<="followers":)\s*\d+' | tr -d ' ' || echo "0")
        following=$(echo "$response" | grep -oP '(?<="following":)\s*\d+' | tr -d ' ' || echo "0")
    fi
    
    # Get starred count - simpler approach
    starred_count=$(curl -s "https://api.github.com/users/$username/starred" | grep -o '"full_name"' | wc -l)
    stars=${starred_count:-0}
    
    # Format the stats
    if [[ -n "$public_repos" ]]; then
        stats_string="repos:$public_repos|followers:$followers|following:$following|stars:$stars"
        
        if [[ "$NUMBERS_ONLY" == true ]]; then
            echo "$stats_string"
        elif [[ "$ONE_LINE" == true ]]; then
            if [[ "$FULL" == true ]]; then
                echo "$public_repos repos, $followers followers, $following following, $stars starred"
            else
                echo "$public_repos repos, $followers followers"
            fi
        else
            echo "GitHub Stats:"
            echo "  Repositories: $public_repos"
            echo "  Followers: $followers"
            if [[ "$FULL" == true ]]; then
                echo "  Following: $following"
                echo "  Starred: $stars"
            fi
        fi
        save_rating "GitHub" "$stats_string"
    else
        echo "Failed to fetch GitHub stats for '$username'"
    fi
}

# Remove old logs or account names
remove_entries() {
    local mode="$1"
    if [[ "$mode" == "accounts" ]]; then
        echo "Removing account entries..."
        > "$CONFIG_FILE"
        echo "All accounts have been removed."
    elif [[ "$mode" == "logs" ]]; then
        echo "Removing old logs..."
        > "$RATINGS_FILE"
        echo "All logs have been removed."
    else
        echo "Invalid mode. Use 'accounts' or 'logs'."
    fi
}

# Process command-line arguments
FORCE_UPDATE=false
REMOVE_MODE=""
SETUP_MODE=false
NUMBERS_ONLY=false
ONE_LINE=false
FULL=false
SHOW_CODEFORCES=false
SHOW_CODECHEF=false
SHOW_LEETCODE=false
SHOW_GITHUB=false
SHOW_ALL=true

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -u|--update) FORCE_UPDATE=true ;;
        -r|--remove) REMOVE_MODE="$2"; shift ;;
        -s|--setup) SETUP_MODE=true ;;
        -n|--numbers-only) NUMBERS_ONLY=true ;;
        -ol|--one-line) ONE_LINE=true ;;
        -f|--full) FULL=true ;;
        -cf|--codeforces) SHOW_CODEFORCES=true; SHOW_ALL=false ;;
        -cc|--codechef) SHOW_CODECHEF=true; SHOW_ALL=false ;;
        -lc|--leetcode) SHOW_LEETCODE=true; SHOW_ALL=false ;;
        -gh|--github) SHOW_GITHUB=true; SHOW_ALL=false ;;
        -v|--version) show_version ;;
        -h|--help) show_help ;;
        *) echo "Unknown parameter passed: $1"; show_help ;;
    esac
    shift
done

# Enter setup mode if requested
if [[ "$SETUP_MODE" == true ]]; then
    setup_config
    exit 0
fi

# Remove accounts or logs if requested
if [[ -n "$REMOVE_MODE" ]]; then
    remove_entries "$REMOVE_MODE"
    exit 0
fi

# Main script logic
check_config

# Fetch ratings based on user selection
if [[ "$SHOW_ALL" == true ]]; then
    get_codeforces_rating "$(get_username_and_timestamp "Codeforces")"
    get_codechef_rating "$(get_username_and_timestamp "CodeChef")"
    get_leetcode_rating "$(get_username_and_timestamp "LeetCode")"
    get_github_stats "$(get_username_and_timestamp "GitHub")"
else
    if [[ "$SHOW_CODEFORCES" == true ]]; then
        get_codeforces_rating "$(get_username_and_timestamp "Codeforces")"
    fi
    if [[ "$SHOW_CODECHEF" == true ]]; then
        get_codechef_rating "$(get_username_and_timestamp "CodeChef")"
    fi
    if [[ "$SHOW_LEETCODE" == true ]]; then
        get_leetcode_rating "$(get_username_and_timestamp "LeetCode")"
    fi
    if [[ "$SHOW_GITHUB" == true ]]; then
        get_github_stats "$(get_username_and_timestamp "GitHub")"
    fi
fi
``